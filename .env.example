# URL pública final, sem barra no final. Deixe vazio até definir o domínio.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=comercial@degstudio.com.br
# Código do país + DDD + número, somente dígitos.
NEXT_PUBLIC_WHATSAPP=
# URL completa HTTPS do perfil real.
NEXT_PUBLIC_INSTAGRAM=
# Endpoint HTTPS privado (n8n, CRM ou serviço de e-mail). Nunca use NEXT_PUBLIC aqui.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_TOKEN=

# SMTP Hostinger: configurar somente no servidor, nunca com NEXT_PUBLIC.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=comercial@degstudio.com.br
SMTP_PASSWORD=

# Portal do Cliente: PostgreSQL privado, fornecido somente em runtime.
DATABASE_URL=
# Use estes dados somente para criar o primeiro usuário de equipe (npm run portal:create-team).
PORTAL_ADMIN_EMAIL=comercial@degstudio.com.br
PORTAL_ADMIN_NAME=Equipe D&G Studio
PORTAL_ADMIN_PASSWORD=
